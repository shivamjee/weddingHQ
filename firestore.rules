rules_version = '2';

// ============================================================================
// weddingHQ Firestore Security Rules — THE security boundary.
// Client-side checks in the app are UX only; this file is what actually keeps
// non-invited people out, and what keeps one wedding's data out of another
// wedding's screens. Default is deny; access is opened per collection.
//
// Access model (multi-tenant):
//   • A "tenant" is one wedding. ALL of its data lives under tenants/{tenantId}/…
//     so isolation is a path prefix, not a filter a query might forget.
//   • Membership is a top-level doc: memberships/{tenantId}__{lowercasedEmail}.
//     It is both the invitation and the membership — the couple (or an admin)
//     writes it fully formed, and the invitee never writes their own role/side.
//     There is therefore no "bootstrap create" hole to defend.
//   • Every member of a tenant may write that wedding's data — config, budgets,
//     contacts, questions, comparisons. role == "couple" adds exactly one extra
//     power: inviting and removing people (the memberships block). Family are
//     parents and in-laws, not untrusted users; the only thing worth gating is
//     who gets in, and that is also the privilege-escalation boundary.
//   • users/{uid}.isAdmin == true is a GLOBAL admin: every tenant, read+write.
//     It is frozen here (nobody can grant it to themselves or anyone else) and
//     is set by hand in the Firestore console. See CLAUDE.md.
//
// COST NOTE: get()/exists() calls below are billed as Firestore document reads.
// Repeated accesses to the SAME path within one request are cached, so a
// membership-list query costs one access, not one per row. This is the only
// place multi-tenancy adds ongoing read cost, and at 5–15 users it is noise
// against the Spark free tier.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // The caller's lowercased email — matches the membership id scheme below.
    function myEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : "";
    }

    // Kept in sync BY HAND with membershipId() in src/lib/paths.ts. Change one,
    // change the other.
    function myMembershipPath(tenantId) {
      return /databases/$(database)/documents/memberships/$(tenantId + "__" + myEmail());
    }

    function isTenantMember(tenantId) {
      return isSignedIn() && exists(myMembershipPath(tenantId));
    }

    function isTenantCouple(tenantId) {
      return isTenantMember(tenantId)
        && get(myMembershipPath(tenantId)).data.role == "couple";
    }

    // Global admin. Uses .get(key, default) so a legacy user doc without the
    // field reads as false rather than erroring the whole rule.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get("isAdmin", false) == true;
    }

    // ---- users/{uid} ------------------------------------------------------
    // Global identity only — no wedding data lives here. A user may read and
    // write their own doc, but `isAdmin` is frozen: it cannot be set on create,
    // changed on update, or granted by anyone else through the client. The
    // first (and any further) admin is set by hand in the Firestore console.
    match /users/{uid} {
      allow get: if request.auth.uid == uid || isAdmin();
      allow list: if isAdmin();

      allow create: if request.auth.uid == uid
        && request.resource.data.get("isAdmin", false) == false;

      allow update: if request.auth.uid == uid
        && request.resource.data.get("isAdmin", false)
             == resource.data.get("isAdmin", false);

      allow delete: if false;
    }

    // ---- memberships/{tenantId}__{email} ----------------------------------
    // The access gate, and THE ONLY couple-gated collection. Everything else in
    // a wedding is member-writable; who gets into the wedding is not, because
    // this is also where privilege escalation would happen.
    //
    // Readable by: the person it names (this is how sign-in
    // discovers which weddings you belong to), anyone else in the same tenant
    // (the member list), and admins.
    //
    // Queries are checked per returned document, so both real queries pass:
    //   where("email","==",me)          → every doc matches clause 1
    //   where("tenantId","==",t)        → every doc matches clause 2
    // while an unfiltered read of the whole collection is denied on the first
    // document that belongs to someone else.
    match /memberships/{membershipId} {

      // Integrity, not privilege: the document id must agree with its fields,
      // or the id-based lookups above could be pointed at the wrong tenant.
      function validShape() {
        let d = request.resource.data;
        return d.tenantId is string
          && d.tenantId.size() > 0
          && d.email is string
          && d.email == d.email.lower()
          && membershipId == d.tenantId + "__" + d.email
          && d.role in ["couple", "family"]
          && d.side in ["a", "b"];
      }

      // A member may stamp their own uid / last-seen on first sign-in, and
      // nothing else — role and side stay where the inviter put them.
      function isSelfStamp() {
        return resource.data.email == myEmail()
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(["uid", "lastSeenAt"]);
      }

      allow read: if isSignedIn() && (
           resource.data.email == myEmail()
        || isTenantMember(resource.data.tenantId)
        || isAdmin()
      );

      allow create: if validShape()
        && (isAdmin() || isTenantCouple(request.resource.data.tenantId));

      allow update: if isSelfStamp()
        || (
          validShape()
          && (isAdmin() || isTenantCouple(resource.data.tenantId))
          // An invitation can never be moved to a different wedding or person.
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.email == resource.data.email
        );

      allow delete: if isAdmin() || isTenantCouple(resource.data.tenantId);
    }

    // ---- tenants/{tenantId} -----------------------------------------------
    // One wedding. `get` is open to its members; `list` is admin-ONLY and that
    // is deliberate: with a member check in a list rule, Firestore would run one
    // exists() per tenant document scanned and hit the 20-document-access limit
    // per query as weddings accumulate. Members never list — they read their
    // memberships, then fetch each tenant by id.
    match /tenants/{tenantId} {
      allow get: if isTenantMember(tenantId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid;
      // Name, side labels and the wedding date are shared planning data, not
      // privileges — any member may correct them. Creating and deleting a
      // wedding stays with admins.
      allow update: if isTenantMember(tenantId) || isAdmin();
      allow delete: if isAdmin();

      // ---- shared config, per wedding -------------------------------------
      // Any member of THIS tenant reads and writes. Categories and events are
      // the vocabulary the whole family plans in; making only the couple able
      // to add "Mehendi" is how the setup screen goes stale.
      match /categories/{categoryId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        allow write: if isTenantMember(tenantId) || isAdmin();
      }

      match /events/{eventId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        allow write: if isTenantMember(tenantId) || isAdmin();
      }

      match /settings/{docId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        allow write: if isTenantMember(tenantId) || isAdmin();
      }

      // ---- budgets (Phase 2 Step 2) ---------------------------------------
      // Per-side allocations and each side's overall ceiling. Every member
      // reads AND writes them — FEATURES.md §0 settled that everyone sees
      // everything, and each side's parents are the people actually setting
      // that side's numbers, so gating writes to the couple only got in the
      // way. The integrity checks below are the real guard here.
      //
      // Three shapes share this collection, told apart by the document id:
      //   {side}_{categoryId}              a category's amount for one side —
      //                                    that category's CEILING
      //   {side}_{categoryId}__{eventId}   an optional breakdown INSIDE that
      //                                    ceiling ("of Decor's ₹2L, ₹50k is
      //                                    Mehendi"), never an extra amount
      //   _totals_{side}                   that side's overall budget
      // Both id schemes come from src/lib/tenantIds.ts, which the rules tests
      // import — so if the app's builders and these strings ever drift, the
      // tests fail rather than every budget write silently being rejected.
      //
      // The id/field agreement below is integrity, not privilege (same reason
      // as memberships): a document whose id disagrees with its own `side` or
      // `categoryId` would be summed into the wrong side's allocation health.
      // `.get(field, default)` is used throughout so a malformed write is a
      // clean denial rather than an evaluation error.
      match /budgets/{budgetId} {
        function validAllocation() {
          let d = request.resource.data;
          let base = d.get("side", "") + "_" + d.get("categoryId", "");
          let eventId = d.get("eventId", null);
          return d.get("side", "") in ["a", "b"]
            && d.get("categoryId", "") is string
            && d.get("categoryId", "").size() > 0
            // An absent or null eventId is the category-level (ceiling) shape;
            // a non-empty string id appends "__{eventId}". Both forms come from
            // budgetAllocationId() in src/lib/tenantIds.ts, which the rules
            // tests import — so a drift here fails the build rather than
            // silently rejecting every per-event write.
            && (
              (eventId == null && budgetId == base)
              || (eventId is string && eventId.size() > 0 && budgetId == base + "__" + eventId)
            )
            // Money is integer paise, always (FEATURES.md §1.3). A float here
            // means someone wrote rupees; a negative means a typo.
            && d.get("allocatedPaise", -1) is int
            && d.get("allocatedPaise", -1) >= 0;
        }
        // NOT checked here: that a category's event amounts sum to no more than
        // its ceiling. That is a cross-document sum, which would need a get()
        // per write, and the overshoot is surfaced in the UI instead.

        function validTotals() {
          let d = request.resource.data;
          return d.get("side", "") in ["a", "b"]
            && budgetId == "_totals_" + d.get("side", "")
            && d.get("totalBudgetPaise", -1) is int
            && d.get("totalBudgetPaise", -1) >= 0;
        }

        allow read: if isTenantMember(tenantId) || isAdmin();
        allow create, update: if (isTenantMember(tenantId) || isAdmin())
          && (validAllocation() || validTotals());
        // Deleting a category or an event removes its allocation documents
        // alongside it.
        allow delete: if isTenantMember(tenantId) || isAdmin();
      }

      // ---- contacts (Phase 2 Step 3) --------------------------------------
      // MEMBER-writable, unlike the config above. Keeping the vendor list
      // current is collaborative: an aunt who gets a decorator's number should
      // be able to add it without waiting for the couple. Nothing here is a
      // financial decision, so there is no reason to restrict it to them.
      match /contacts/{contactId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        allow write: if isTenantMember(tenantId) || isAdmin();
      }

      // ---- questions (Phase 2 Step 4) -------------------------------------
      // Also member-writable — anyone who thinks of a question should be able
      // to write it down before they forget it.
      match /questions/{questionId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        allow write: if isTenantMember(tenantId) || isAdmin();
      }

      // ---- comparisons (Phase 2 Step 5) -----------------------------------
      // Also collaborative, so member-read and member-write.
      //
      // The `options` subcollection needs its OWN match block: a rule on the
      // parent does not cascade to a subcollection, so without this block the
      // default-deny at the bottom would apply and every option would be
      // invisible. The {optionId=**} recursive form is deliberately NOT used —
      // this grants exactly one known level, not anything a future nested
      // collection might add.
      //
      // Step 5b's AI route handler adds nothing here: it returns a suggestion
      // and the CLIENT writes the confirmed result under this same member-write
      // rule, so the security boundary stays exactly where it is.
      match /comparisons/{comparisonId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        allow write: if isTenantMember(tenantId) || isAdmin();

        match /options/{optionId} {
          allow read: if isTenantMember(tenantId) || isAdmin();
          allow write: if isTenantMember(tenantId) || isAdmin();
        }
      }

      // ---- guest list (Phase 3) -------------------------------------------
      // Member-writable, and emphatically so: the whole premise is that four
      // people — the couple and both sets of parents — contribute names
      // independently (FEATURES.md §4). Gating this to the couple would mean
      // parents emailing lists to be typed in, which is the workflow the
      // feature exists to replace.
      //
      // No field-shape validation here, unlike budgets. There is no id/field
      // agreement to protect (auto-ids), and a wrong head count is a planning
      // mistake to fix on screen, not a privilege boundary to defend.
      match /households/{householdId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        allow write: if isTenantMember(tenantId) || isAdmin();
      }

      // Named guests. TOP-LEVEL under the tenant rather than nested under a
      // household, so this is an ordinary rules block and tenant isolation
      // stays a path prefix — a `guests` SUBcollection would force
      // collectionGroup queries in Phase 6, and those match every path depth in
      // the whole database, including other weddings. See src/types/guest.ts.
      match /guests/{guestId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        allow write: if isTenantMember(tenantId) || isAdmin();
      }

      // Derived rollups (currently only `guestTotals`, read by Home so it
      // doesn't have to load every household). Not shape-validated on purpose:
      // it is recomputed from documents the same member can already write
      // directly, so a rule here would guard nothing they couldn't do anyway.
      match /aggregates/{docId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        allow write: if isTenantMember(tenantId) || isAdmin();
      }

      // Append-only change log (FEATURES.md §4.3). CREATE only — no update, no
      // delete, for members, the couple and the global admin alike. An audit
      // log anyone can rewrite does not answer "who deleted my aunt?", which is
      // the entire reason it exists. `by` must be the caller, so an entry
      // cannot be filed under somebody else's name.
      match /guestLog/{entryId} {
        allow read: if isTenantMember(tenantId) || isAdmin();
        allow create: if (isTenantMember(tenantId) || isAdmin())
          && request.resource.data.get("by", "") == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---- everything else --------------------------------------------------
    // Explicit default-deny, including any tenant subcollection not listed
    // above and the Phase 1 top-level collections (allowlist, categories,
    // events, settings) which no longer exist.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
