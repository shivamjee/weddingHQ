# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never committed; the example template IS committed
.env*
!.env.local.example

# vercel
.vercel

# firebase (emulator + local artifacts; never commit service-account keys)
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log
serviceAccountKey.json

# typescript
*.tsbuildinfo
next-env.d.ts

certificates

# graphify: local machine state + regenerable extraction cache.
# graph.json / GRAPH_REPORT.md / graph.html / manifest.json / cost.json / labels ARE tracked.
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
