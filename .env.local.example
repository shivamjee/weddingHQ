# Firebase Web App config — copy this file to `.env.local` and paste in the real
# values from the Firebase console (Project settings → General → Your apps → SDK setup).
#
# These are NOT secrets — Firebase web config is public by design. Access is
# enforced by Firestore Security Rules, not by hiding these. Safe to expose in
# the browser bundle; the NEXT_PUBLIC_ prefix makes that explicit.
#
# Set the SAME values in the Vercel dashboard (Project → Settings → Environment
# Variables) so production has them too. `.env.local` itself is gitignored.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Gemini — the comparison-table AI assist (Phase 2 Step 5b). OPTIONAL.
#
# ⚠️ UNLIKE EVERYTHING ABOVE, THIS ONE IS A REAL SECRET. It deliberately has NO
# NEXT_PUBLIC_ prefix, which is what stops Next.js inlining it into the browser
# bundle — anyone who could read it out of DevTools could spend the quota.
#
# Get one free at https://aistudio.google.com/apikey (no credit card, no billing
# account). Add the same value in Vercel → Settings → Environment Variables for
# Production and Preview, then redeploy so the running build picks it up.
#
# Leave it blank and the app works exactly as before, with the "Add with AI"
# button hidden. Nothing else depends on it.
GEMINI_API_KEY=

# Optional override — Google renames and retires model ids, so check the live
# list in AI Studio if the app reports the model isn't available.
# GEMINI_MODEL=gemini-2.5-flash-lite
